{
  "name": "kings-of-glory",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-pnpm.mjs --parallel --filter @kings/client --filter @kings/server dev",
    "build": "node scripts/run-pnpm.mjs -r build",
    "test": "node scripts/run-pnpm.mjs -r test",
    "typecheck": "node scripts/run-pnpm.mjs build",
    "lint": "node scripts/run-pnpm.mjs -r lint",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3"
  }
}
